bool __cdecl ATaskTempl::LoadDescriptionBin(ATaskTempl *const this, FILE *fp)
{
  size_t len[3]; // [esp+Ch] [ebp-Ch] BYREF

  len[0] = 0;
  fread(len, 4u, 1u, fp);
  this->m_pwstrDescript = (task_char *)operator new[](2 * (len[0] + 1));
  this->m_pwstrDescript[len[0]] = 0;
  if ( len[0] )
  {
    fread(this->m_pwstrDescript, 2u, len[0], fp);
    convert_txt(this->m_pwstrDescript, len[0], this->m_ID);
  }
  ++g_ulNewCount;
  len[0] = 0;
  fread(len, 4u, 1u, fp);
  this->m_pwstrOkText = (task_char *)operator new[](2 * (len[0] + 1));
  this->m_pwstrOkText[len[0]] = 0;
  if ( len[0] )
  {
    fread(this->m_pwstrOkText, 2u, len[0], fp);
    convert_txt(this->m_pwstrOkText, len[0], this->m_ID);
  }
  ++g_ulNewCount;
  len[0] = 0;
  fread(len, 4u, 1u, fp);
  this->m_pwstrNoText = (task_char *)operator new[](2 * (len[0] + 1));
  this->m_pwstrNoText[len[0]] = 0;
  if ( len[0] )
  {
    fread(this->m_pwstrNoText, 2u, len[0], fp);
    convert_txt(this->m_pwstrNoText, len[0], this->m_ID);
  }
  ++g_ulNewCount;
  return 1;
}